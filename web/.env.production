# npm run build — the API URLs come from config/app.yaml (urls.production).
# Edit them there. To override for one build without touching app.yaml, set
# VITE_API_BASE_URL / VITE_UPLOAD_BASE_URL here, in .env.production.local, or
# with docker build --build-arg VITE_API_BASE_URL=...
# Only public URLs: every VITE_* value is compiled into the browser bundle.
