# GradeAnt API — every setting, documented. No real values belong in this file.
#
# Files loaded: .env.<mode>, then .env.<mode>.local (gitignored, for secrets and
# personal overrides), which overrides it. Real environment variables always win.
# Mode: --mode=<name> (npm scripts) › APP_ENV › production when running on
# Lambda Web Functions › development.

# ---- Mode & server ----------------------------------------------------------------
# development | production | test
APP_ENV=
# Local listen address. On Lambda the runtime sets AWS_LAMBDA_HTTP_ENDPOINT instead.
HOST=127.0.0.1
PORT=8787
# Optional path prefix for every route (e.g. /dev behind a front door that adds one).
API_BASE_PATH=
# Public URL of this server; only used to build local-storage links in development.
PUBLIC_BASE_URL=https://rus9nultj9.execute-api.eu-north-1.amazonaws.com/dev
BODY_LIMIT=1mb
LOG_REQUESTS=true

# URLs, API paths, roles and permissions live in config/app.yaml (the main config).
# Optional overrides of app.yaml: comma-separated CORS origins, or *.
CORS_ALLOWED_ORIGINS=

# ---- Drivers: what each integration talks to ---------------------------------------
# In production, database / AI / email / secrets / grading come from config/app.yaml
# (`deployment:` → deployments.<name>.providers). Setting one of these variables
# overrides that switch, so leave them empty in production unless you mean to.
# memory (in-process DynamoDB emulator, dev only) | dynamodb | postgres (Supabase)
DB_DRIVER=
# local (files under LOCAL_STORAGE_DIR) | s3
STORAGE_DRIVER=
# log | ses
MAIL_DRIVER=
# log | sns
NOTIFY_DRIVER=
# inline (run jobs in the request) | sqs (send to JOBS_QUEUE_URL, run by worker.js)
JOBS_DRIVER=
# canned (no AI calls) | gemini
AI_DRIVER=
# log | lambda (invoke GRADING_FUNCTION_NAME) | sqs (send to the grading-jobs queue)
GRADING_DRIVER=

# ---- Supabase Postgres (DB_DRIVER=postgres / deployment providers.database: supabase) --
# Supabase → Connect → Session pooler URI (IPv4, port 5432) with the database password.
# Secret: set it in the host's dashboard (Render), never in a committed file.
# Create the tables once with: npm run sql:apply
SUPABASE_DB_URL=
# Connections per server instance (Supabase Free: 200 pooler clients in total).
PG_POOL_MAX=5
# Supabase's CA certificate (PEM; "\n" for line breaks) to verify the server. Without it
# the connection is encrypted but the certificate isn't checked.
PG_SSL_CA=

# ---- AWS ----------------------------------------------------------------------------
# Region of the DynamoDB tables, S3 buckets, SES, SNS, SQS. AWS_REGION is reserved on
# Lambda Web Functions (it is the function's own Region), so set this when they differ.
AWS_DATA_REGION=
# DynamoDB Local endpoint (e.g. http://localhost:8000) when DB_DRIVER=dynamodb locally.
DYNAMODB_ENDPOINT=
# Create tables and load demo users into a local database on startup.
SEED_DEMO_DATA=false

# ---- DynamoDB tables (defaults shown) ---------------------------------------------
USERS_TABLE=Users
GRADING_TABLE=assignment_grading
# Optional GSI on assignment_grading (PK assignment_id); recommended for large classes.
GRADING_ASSIGNMENT_INDEX=assignment_id-index
ASSIGNMENTS_TABLE=GradeAnt_Assignments
SUBMISSIONS_TABLE=GradeAnt_Submissions
ANNOUNCEMENTS_TABLE=GradeAnt_Announcements
ADMIN_USERS_TABLE=GradeAnt_Users
RESET_REQUESTS_TABLE=GradeAnt_ResetRequests
CONTENT_TABLE=GradeAnt_Content
TICKETS_TABLE=GradeAnt_Tickets
AUDIT_LOGS_TABLE=GradeAnt_AuditLogs
SETTINGS_TABLE=GradeAnt_Settings
INVITES_TABLE=GradeAnt_Invites
ANALYTICS_TABLE=GradeAnt_Analytics

# ---- Auth (secrets) ---------------------------------------------------------------
# Production: give the Secrets Manager secret ARN (plain string, or JSON {"JWT_SECRET": "..."}).
# It must be the same secret the Python Lambdas sign with, so existing sessions stay valid.
JWT_SECRET_ARN=
# Development only: the secret itself (put it in .env.development.local, not here).
JWT_SECRET=
TOKEN_EXPIRY_SECONDS=86400
# Admin first-login session tokens (lambda_admin.py's own format).
SESSION_TOKEN_SECRET_ARN=
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL_SECONDS=86400
INVITE_TOKEN_TTL_SECONDS=604800

# ---- Storage ----------------------------------------------------------------------
PROFILE_PHOTO_BUCKET=
# /uploadpdf presigned uploads. Leave empty to keep using the existing upload Lambda.
UPLOAD_BUCKET=
# Placeholders: {uploadType} {assignmentId} {qpId} {studentId} {courseId} {fileName} {uuid}
UPLOAD_KEY_TEMPLATE=uploads/{uploadType}/{assignmentId}/{fileName}
# template (keys from UPLOAD_KEY_TEMPLATE) | pipeline (the grading pipeline's layout and
# server-chosen file names; then UPLOAD_BUCKET must equal PIPELINE_BUCKET)
UPLOAD_LAYOUT=template
PIPELINE_BUCKET=
PIPELINE_ROOT=Data_warehouse
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900
LOCAL_STORAGE_DIR=.data/storage

# ---- Email, notifications, jobs, grading pipeline --------------------------------
# From address for reminders (SES-verified). Empty = reminders are not emailed.
SES_SENDER_EMAIL=
# From address for admin invites (defaults to SES_SENDER_EMAIL, then no-reply@gradeant.io).
INVITE_SENDER_EMAIL=
# Inbox for the website's contact and request-a-pilot forms (default contact@gradeant.com).
CONTACT_INBOX=
# From address for those emails (SES-verified; defaults to SES_SENDER_EMAIL). Visitor goes in Reply-To.
CONTACT_SENDER_EMAIL=
# Optional override of app.yaml urls.<mode>.web (the web app URL, used in invite links).
APP_BASE_URL=
# "Grades published" topic. Empty = no notification.
SNS_TOPIC_ARN=
JOBS_QUEUE_URL=
# Lambda that grades one submission (invoked asynchronously). Empty = not triggered.
GRADING_FUNCTION_NAME=
# GRADING_DRIVER=sqs: the grader's SQS queue URL ("Start grading" as a message). Empty = not triggered.
GRADING_QUEUE_URL=
# Answers graded with lower confidence are spot-checked by the teacher.
FLAG_CONFIDENCE=0.75

# ---- Gemini (AI_DRIVER=gemini / deployment providers.ai: gemini) ----------------------
# Paid-tier key for student data (Google's free tier may use content to improve its products).
GEMINI_API_KEY=
# On AWS (providers.secrets: aws) the key can instead come from Secrets Manager:
GEMINI_API_KEY_ARN=
# The one model for every AI call (assistant, rubric drafting, grading, reading answer sheets).
GEMINI_MODEL=gemini-3.5-flash-preview
