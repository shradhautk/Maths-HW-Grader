{
  "name": "gradeant-api",
  "version": "1.0.0",
  "private": true,
  "description": "GradeAnt API — Node.js + Express, runs locally and on AWS Lambda Web Functions",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=index.js index.js --mode=development",
    "start": "node index.js",
    "start:prod": "node index.js --mode=production",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\"",
    "test:pg": "node scripts/test-pg.mjs",
    "sql:apply": "node scripts/sql-apply.mjs",
    "backup": "node scripts/backup.mjs",
    "check:parity": "node scripts/parity.mjs",
    "package": "node scripts/package.mjs",
    "package:lambdas": "node scripts/package-lambdas.mjs",
    "check:lambdas": "node lambdas/check-graph.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-ses": "^3.1152.0",
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@google/genai": "^3.6.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "dynalite": "^4.0.0"
  }
}
